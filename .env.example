# Copy to .env and fill in. Loaded by run.sh / the launchd plist.
#
# Every setting is STREAM_SLEUTH_<NAME>. WXDU's original WXDU_<NAME> spellings
# (WXDU_STREAM_URL, WXDU_SHAZAM_SECRET, ...) keep working as aliases; when both
# are set, the STREAM_SLEUTH_ name wins, and an empty one counts as unset.
# The example values are WXDU's; WXYC's are in examples/wxyc.env.

# Stream to sample. 192 kbps is plenty for recognition, but let's use 320
# just in case it helps.
STREAM_SLEUTH_STREAM_URL=https://stream.wxdu.art/wxdu320.mp3

# Where identifications go: http (POST each new song to STREAM_SLEUTH_SHAZAM_API,
# the default) or jsonl (append one JSON line per song to STREAM_SLEUTH_OUTPUT_PATH;
# needs no API or secret). The path must be absolute, in an existing directory
# outside this checkout, e.g. $HOME/.local/share/stream-sleuth/emissions.jsonl.
STREAM_SLEUTH_OUTPUT=http
STREAM_SLEUTH_OUTPUT_PATH=

# The wxdu API ingest endpoint. NOTE: api.wxdu.art (the Node API via nginx), NOT
# wxdu.art (that's the Cloudflare Pages frontend and won't accept POSTs).
STREAM_SLEUTH_SHAZAM_API=https://api.wxdu.art/api/shazam

# Shared secret -- MUST match SHAZAM_INGEST_SECRET in the wxdu API's .env.
# Required for the http output; the refusal to run without it names the
# WXDU_SHAZAM_SECRET alias. Generate one with: openssl rand -hex 32
STREAM_SLEUTH_SHAZAM_SECRET=

# Pause between attempts while a track is identified. Relaxed -- the song's
# already known, so there's no rush; keeps things gentle on Shazam.
STREAM_SLEUTH_INTERVAL=23

# Pause between attempts during a miss/gap (when it can't identify what's on
# air). Short, so it catches the next track quickly. The 12s gap capture floors
# the real cadence at ~15s regardless, so going much below ~4 gains little.
STREAM_SLEUTH_INTERVAL_GAP=4

# Adaptive capture length. It starts at FAST; any hit keeps it fast, a miss
# escalates to SLOW until the next hit. FAST = quick/cheap while a track is
# identified; SLOW = more audio to catch a hard-to-ID new track.
STREAM_SLEUTH_CAPTURE_FAST=6
STREAM_SLEUTH_CAPTURE_SLOW=12

# Set to 1 to log every cycle (same-song hits and repeat misses too), so you can
# watch it tick. Leave unset/0 for a quiet production log that only reports new
# songs and the start of each gap.
STREAM_SLEUTH_VERBOSE=0
