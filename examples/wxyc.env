# WXYC 89.3 FM, Chapel Hill. Copy to .env to run against WXYC's public stream.
# See .env.example for what each setting does.
#
# WXYC has no ingest API yet, so identifications are appended to a local JSONL
# file instead of POSTed; no secret is needed. The file lives in the data
# directory, outside the checkout; create it first:
#   mkdir -p ~/.local/share/stream-sleuth
# The path must be absolute; run.sh and dotenv loaders expand ${HOME}, but a
# launchd plist does not, so spell it out there.

STREAM_SLEUTH_STREAM_URL=https://audio-mp3.ibiblio.org/wxyc.mp3
STREAM_SLEUTH_OUTPUT=jsonl
STREAM_SLEUTH_OUTPUT_PATH=${HOME}/.local/share/stream-sleuth/wxyc-emissions.jsonl
STREAM_SLEUTH_INTERVAL=23
STREAM_SLEUTH_INTERVAL_GAP=4
STREAM_SLEUTH_CAPTURE_FAST=6
STREAM_SLEUTH_CAPTURE_SLOW=12
STREAM_SLEUTH_VERBOSE=0
